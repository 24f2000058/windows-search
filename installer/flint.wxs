<?xml version="1.0" encoding="utf-8"?>
<!--
  Flint per-user installer (WiX v3 schema; built with `wixl` from msitools
  on Linux, or WiX v3 candle/light on Windows).

  * Installs to %LOCALAPPDATA%\Programs\Flint without elevation.
  * Start menu shortcut; start at sign-in (feature "Autostart", on by
    default; leave it out with: msiexec /i Flint.msi ADDLOCAL=Main).
  * Upgrades replace older versions (MajorUpgrade); downgrades are refused.
  * Uninstall stops the running launcher, removes the program, shortcut and
    sign-in entry, and the rebuildable index/cache. Settings, plugins and
    approvals are kept unless REMOVEDATA=1:
        msiexec /x Flint.msi REMOVEDATA=1
  Variables: -D Version=x.y.z -D ProductCode=<GUID, derived from the version
  by tools/release.sh> -D SourceDir=<folder with the files>
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)" Name="Flint" Language="1033" Version="$(var.Version)" Manufacturer="Flint contributors" UpgradeCode="7d3f8a64-4c1e-4b8a-9b0e-5f2a1c9e6d31">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Description="Flint keyboard launcher" Comments="https://github.com/24f2000058/windows-search" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Flint is already installed." />
    <Media Id="1" Cabinet="flint.cab" EmbedCab="yes" />
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <Property Id="REMOVEDATA" Value="0" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/24f2000058/windows-search" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Flint" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Launcher" Guid="0f5b7f6e-2b0a-4a47-a1d4-9ab2c7d1e001">
        <File Id="FlintExe" Name="flint.exe" Source="$(var.SourceDir)/flint.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Flint" Name="Installed" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
      </Component>
      <Component Id="PreviewHost" Guid="0f5b7f6e-2b0a-4a47-a1d4-9ab2c7d1e002">
        <File Id="PreviewHostExe" Name="flint-preview-host.exe" Source="$(var.SourceDir)/flint-preview-host.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Flint" Name="PreviewHost" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Notices" Guid="0f5b7f6e-2b0a-4a47-a1d4-9ab2c7d1e003">
        <File Id="LicenseMit" Name="LICENSE-MIT.txt" Source="$(var.SourceDir)/LICENSE-MIT.txt" KeyPath="no" />
        <File Id="LicenseApache" Name="LICENSE-APACHE.txt" Source="$(var.SourceDir)/LICENSE-APACHE.txt" KeyPath="no" />
        <File Id="ThirdParty" Name="THIRD-PARTY-NOTICES.txt" Source="$(var.SourceDir)/THIRD-PARTY-NOTICES.txt" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Flint" Name="Notices" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Autostart" Guid="0f5b7f6e-2b0a-4a47-a1d4-9ab2c7d1e004">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Flint" Type="string" Value="&quot;[INSTALLDIR]flint.exe&quot;" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramsDir">
      <Component Id="ProgramsFolder" Guid="0f5b7f6e-2b0a-4a47-a1d4-9ab2c7d1e006">
        <RemoveFolder Id="RemoveProgramsDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Flint" Name="ProgramsFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="0f5b7f6e-2b0a-4a47-a1d4-9ab2c7d1e005">
        <Shortcut Id="FlintShortcut" Name="Flint" Description="Keyboard launcher (Ctrl+Space)" Target="[INSTALLDIR]flint.exe" WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\Flint" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Flint" Level="1">
      <ComponentRef Id="Launcher" />
      <ComponentRef Id="PreviewHost" />
      <ComponentRef Id="Notices" />
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="ProgramsFolder" />
    </Feature>
    <Feature Id="Autostart" Title="Start Flint when you sign in" Level="1">
      <ComponentRef Id="Autostart" />
    </Feature>

    <!-- Uninstall/upgrade: close the running launcher before files are replaced. -->
    <CustomAction Id="QuitLauncher" FileKey="FlintExe" ExeCommand="--quit" Execute="immediate" Return="ignore" />
    <!-- Full uninstall: remove the rebuildable index/cache, or everything with REMOVEDATA=1. -->
    <CustomAction Id="CleanupCache" FileKey="FlintExe" ExeCommand="--cleanup-data" Execute="immediate" Return="ignore" />
    <CustomAction Id="CleanupAll" FileKey="FlintExe" ExeCommand="--cleanup-data --all" Execute="immediate" Return="ignore" />
    <!-- Start the launcher after installing (not when uninstalling). -->
    <CustomAction Id="StartLauncher" FileKey="FlintExe" ExeCommand="" Execute="immediate" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <!-- After CostFinalize (file paths known), before InstallValidate (files-in-use check). -->
      <Custom Action="QuitLauncher" Sequence="1300">Installed</Custom>
      <Custom Action="CleanupCache" Sequence="1301">REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE AND REMOVEDATA &lt;&gt; "1"</Custom>
      <Custom Action="CleanupAll" Sequence="1302">REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE AND REMOVEDATA = "1"</Custom>
      <Custom Action="StartLauncher" After="InstallFinalize">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
